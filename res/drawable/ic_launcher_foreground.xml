<?xml version="1.0" encoding="utf-8"?>
<!-- A beamed pair of eighth notes, tilted the way a real note head is, running green into cyan with a
     violet beam. Everything stays inside the 18..90 safe zone, because a launcher masks the plate to a
     circle, a squircle or a pill and will cut anything that wanders out of it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="30"
        android:pivotY="76"
        android:rotation="-22"
        android:scaleY="0.76">
        <path android:pathData="M21,76 A9,9 0 1 0 39,76 A9,9 0 1 0 21,76 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="21" android:startY="85"
                    android:endX="39" android:endY="67">
                    <item android:offset="0" android:color="@color/icon_note_a" />
                    <item android:offset="1" android:color="@color/icon_note_b" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <group
        android:pivotX="70"
        android:pivotY="70"
        android:rotation="-22"
        android:scaleY="0.76">
        <path android:pathData="M61,70 A9,9 0 1 0 79,70 A9,9 0 1 0 61,70 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="61" android:startY="79"
                    android:endX="79" android:endY="61">
                    <item android:offset="0" android:color="@color/icon_note_a" />
                    <item android:offset="1" android:color="@color/icon_note_b" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <path android:pathData="M37,34 L41,34 L41,77 L37,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37" android:startY="77"
                android:endX="41" android:endY="34">
                <item android:offset="0" android:color="@color/icon_note_a" />
                <item android:offset="1" android:color="@color/icon_note_b" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M77,28 L81,28 L81,71 L77,71 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="77" android:startY="71"
                android:endX="81" android:endY="28">
                <item android:offset="0" android:color="@color/icon_note_a" />
                <item android:offset="1" android:color="@color/icon_note_b" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M37,34 L81,26 L81,40 L37,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37" android:startY="48"
                android:endX="81" android:endY="26">
                <item android:offset="0" android:color="@color/icon_note_c" />
                <item android:offset="1" android:color="@color/icon_note_b" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
