         readable at a glance instead of one long grey column. -->
    <color name="tab_now">#FF1ED760</color>
    <color name="tab_style">#FFC974FF</color>
    <color name="tab_overlay">#FFFF7AB8</color>
    <color name="tab_sources">#FF4FD8FF</color>
    <color name="tab_settings">#FFFFB45C</color>
    <color name="card">#FF1A1725</color>
    <color name="card_soft">#FF241F33</color>
    <color name="ink">#FFF3F0FF</color>
