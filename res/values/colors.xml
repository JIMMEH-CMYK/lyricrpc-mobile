         system app. Shared with the UI so the shade, the overlay and the icon are the same palette. -->
    <color name="icon_plate_a">#FF1B1035</color>
    <color name="icon_plate_b">#FF0E2A46</color>
    <color name="icon_plate_c">#FF08332B</color>
    <color name="icon_glow">#4D1ED760</color>
    <color name="icon_note_a">#FF1ED760</color>
    <color name="icon_note_b">#FF4FD8FF</color>
    <color name="icon_note_c">#FFC974FF</color>

